<?xml version="1.0" encoding="utf-8"?>
<!-- BottleMap icon "error" (docs/android_icons.md). Draw it with BmIcon (ui/common/BmIcon.kt).
     "skeleton": the 1.5 outline (style A). "accent": the shape filled only when selected (style B);
     transparent here, BmIcon colours it from MaterialTheme.colorScheme.primary at runtime. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:name="accent"
        android:fillColor="#00000000"
        android:fillAlpha="0.5"
        android:pathData="M3 12 A9 9 0 1 1 21 12 A9 9 0 1 1 3 12 Z" />
    <path
        android:name="skeleton"
        android:fillColor="#00000000"
        android:strokeColor="@color/bm_icon_line"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3 12 A9 9 0 1 1 21 12 A9 9 0 1 1 3 12 Z M12 7.25 V12.75" />
    <path
        android:name="skeleton_dot"
        android:fillColor="@color/bm_icon_line"
        android:pathData="M11 16.25 A1 1 0 1 1 13 16.25 A1 1 0 1 1 11 16.25 Z" />
</vector>
