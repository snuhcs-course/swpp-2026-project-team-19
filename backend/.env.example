# Local PostgreSQL connection settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bottlemap
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=bottlemap
# Optional: libpq sslmode, e.g. require for RDS (default: prefer)
# POSTGRES_SSLMODE=require
# Test database used by pytest; its schema is dropped on every run, so it must end with _test
POSTGRES_TEST_DATABASE=bottlemap_test

# Menu photo storage and extraction (local development defaults)
IMAGE_STORAGE=local
# IMAGE_STORAGE_DIR=/absolute/path/for/images   # default: backend/var/images
# For S3 (deployment): IMAGE_STORAGE=s3 and
# S3_BUCKET=your-bucket
# AWS_REGION=ap-northeast-2
# S3_URL_TTL_SECONDS=900
# mock (default; fixed results, no key needed) | gemini (needs GEMINI_API_KEY and the EXTRACTION_* values below)
MENU_EXTRACTOR=mock

# Supabase Auth (Google login). Leave SUPABASE_URL empty to accept only temporary tokens.
# The project URL is public; token verification needs no Supabase secret or service_role key.
SUPABASE_URL=
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ALGORITHMS=ES256   # asymmetric only; HS256 is rejected
# Operator dashboard (/admin) Google login in the browser: the publishable (or legacy anon) key. Public, not a secret.
# Also add http://localhost:8000/admin/ to the Supabase Redirect URLs.
# SUPABASE_PUBLISHABLE_KEY=
# Operator dashboard map and address search: the Kakao JavaScript key (public; register http://localhost:8000
# under Platform > Web in Kakao Developers). Without it the coordinates are typed by hand. Open the dashboard at
# http://localhost:8000/admin/, not 127.0.0.1: the address search answers 401 on an unregistered domain.
# KAKAO_JAVASCRIPT_KEY=

# Temporary authentication is disabled by default.
TEMP_AUTH_ENABLED=false
TEMP_AUTH_JWT_SECRET=replace-with-a-local-secret-at-least-32-characters
TEMP_AUTH_USER_TYPE=customer # customer | operator

# Menu extraction (app/extraction). Required only with MENU_EXTRACTOR=gemini; checked at server start.
GEMINI_API_KEY=
# P14 adopted condition A2: gemini-3.5-flash-lite with thinking medium
EXTRACTION_MODEL=gemini-3.5-flash-lite
EXTRACTION_THINKING_LEVEL=medium
# Optional; defaults are the P14 values (worst case several minutes per photo)
# EXTRACTION_MAX_ATTEMPTS=6
# EXTRACTION_REQUEST_TIMEOUT_S=300
# EXTRACTION_WALL_TIMEOUT_S=330
# P35: gemini (default, photo only) | hybrid (CLOVA OCR lines + photo; falls back to gemini when OCR fails)
# EXTRACTION_MODE=gemini
# Required with EXTRACTION_MODE=hybrid (CLOVA General OCR, APIGW invoke URL and secret). The business
# certificate OCR (spec 3.11.12) uses them too; without them it answers 503 OCR_UNAVAILABLE.
# CLOVA_OCR_INVOKE_URL=
# CLOVA_OCR_SECRET=
# I4-P12, with EXTRACTION_MODE=hybrid: v1 (default, whisky lines only) | v2 (also reads cocktail, food and
# other drink lines; they are kept in the run's raw_output `otherItems` and are not sent to matching)
# EXTRACTION_HYBRID_PROMPT=v1

# LLM matching layer (I3, M3 on gemini-3.1-flash-lite) for menu lines S1-S3 leave unconfirmed.
# Off unless true; needs GEMINI_API_KEY (without it the layer stays off with a warning).
# Its candidates are always ambiguous (the owner confirms); a failed call keeps the rule result.
MATCHING_LLM_ENABLED=false
# Optional: model requests per menu import (default 30); M3b was not adopted in I2, so it stays off
# MATCHING_LLM_MAX_CALLS=30
# MATCHING_LLM_M3B_ENABLED=false
# m3a (default) | tools (I3-E10 tool calling; one request per conversation turn, so raise MATCHING_LLM_MAX_CALLS to 90)
MATCHING_LLM_MODE=m3a

# Embedding candidate step (I3-P40), after the rules and the LLM layer. Off unless true.
# Lines still unmatched get up to 5 similar products as ambiguous candidates (method embedding);
# ambiguous lines without confirmRecommended are only reordered. It never confirms a line.
EMBEDDING_ENABLED=false
# Optional: tfidf (character n-gram TF-IDF in the API process, default; the only model so far)
# EMBEDDING_MODEL=tfidf
# Optional: candidates below this cosine similarity are dropped (default per model: tfidf 0.38)
# EMBEDDING_MIN_SIMILARITY=0.38

# Customer search step 5 "similar" (API spec 3.10.1). Off unless true. When brand, alias_exact and
# partial find nothing, up to 5 products with the most similar name or searchable alias (character
# TF-IDF in the API process, no model call) come back as matchType similar instead of none.
SEARCH_SIMILAR_ENABLED=false
# Optional: products below this cosine similarity are left out (default 0.38, the P24 TF-IDF floor)
# SEARCH_SIMILAR_MIN_SIMILARITY=0.38

# Owner application check (spec 3.11.2, 3.11.13): data.go.kr service key for the NTS business
# registration validation API (국세청_사업자등록정보 진위확인 및 상태조회 서비스). Without it, applications
# are accepted with the result unavailable, and the operator recheck (verify-business) answers 503.
# NTS_SERVICE_KEY=

# Owner applications: keys for the stored business registration numbers (app/core/business_number_crypto.py).
# Required: the server does not start without them. Make your own local keys, two different ones, with
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rows written with one key cannot be read with another, so keep the keys while you keep your database.
# Tests use their own keys and ignore these.
BUSINESS_NUMBER_ENCRYPTION_KEYS=
BUSINESS_NUMBER_HMAC_KEY=
