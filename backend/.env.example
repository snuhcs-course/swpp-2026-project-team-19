# Local PostgreSQL connection settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bottlemap
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=bottlemap
# Optional: libpq sslmode, e.g. require for RDS (default: prefer)
# POSTGRES_SSLMODE=require
# Test database used by pytest; its schema is dropped on every run, so it must end with _test
POSTGRES_TEST_DATABASE=bottlemap_test

# Menu photo storage and extraction (local development defaults)
IMAGE_STORAGE=local
# IMAGE_STORAGE_DIR=/absolute/path/for/images   # default: backend/var/images
# For S3 (deployment): IMAGE_STORAGE=s3 and
# S3_BUCKET=your-bucket
# AWS_REGION=ap-northeast-2
# S3_URL_TTL_SECONDS=900
# mock (default; fixed results, no key needed) | gemini (needs GEMINI_API_KEY and the EXTRACTION_* values below)
MENU_EXTRACTOR=mock

# Supabase Auth (Google login). Leave SUPABASE_URL empty to accept only temporary tokens.
# The project URL is public; token verification needs no Supabase secret or service_role key.
SUPABASE_URL=
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ALGORITHMS=ES256   # asymmetric only; HS256 is rejected

# Temporary authentication is disabled by default.
TEMP_AUTH_ENABLED=false
TEMP_AUTH_JWT_SECRET=replace-with-a-local-secret-at-least-32-characters
TEMP_AUTH_USER_TYPE=customer # customer | operator

# Menu extraction (app/extraction). Required only with MENU_EXTRACTOR=gemini; checked at server start.
GEMINI_API_KEY=
# P14 adopted condition A2: gemini-3.5-flash-lite with thinking medium
EXTRACTION_MODEL=gemini-3.5-flash-lite
EXTRACTION_THINKING_LEVEL=medium
# Optional; defaults are the P14 values (worst case several minutes per photo)
# EXTRACTION_MAX_ATTEMPTS=6
# EXTRACTION_REQUEST_TIMEOUT_S=300
# EXTRACTION_WALL_TIMEOUT_S=330
# P35: gemini (default, photo only) | hybrid (CLOVA OCR lines + photo; falls back to gemini when OCR fails)
# EXTRACTION_MODE=gemini
# Required with EXTRACTION_MODE=hybrid (CLOVA General OCR, APIGW invoke URL and secret). The business
# certificate OCR (spec 3.11.12) uses them too; without them it answers 503 OCR_UNAVAILABLE.
# CLOVA_OCR_INVOKE_URL=
# CLOVA_OCR_SECRET=

# LLM matching layer (I3, M3 on gemini-3.1-flash-lite) for menu lines S1-S3 leave unconfirmed.
# Off unless true; needs GEMINI_API_KEY (without it the layer stays off with a warning).
# Its candidates are always ambiguous (the owner confirms); a failed call keeps the rule result.
MATCHING_LLM_ENABLED=false
# Optional: model requests per menu import (default 30); M3b was not adopted in I2, so it stays off
# MATCHING_LLM_MAX_CALLS=30
# MATCHING_LLM_M3B_ENABLED=false

# Owner application check (spec 3.11.2): data.go.kr service key for the NTS business registration
# validation API (국세청_사업자등록정보 진위확인 및 상태조회 서비스). Without it, applications are accepted
# with the result unavailable and operators check them again later.
# NTS_SERVICE_KEY=
