# Local PostgreSQL connection settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bottlemap
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=bottlemap

# Temporary authentication is disabled by default.
TEMP_AUTH_ENABLED=false
TEMP_AUTH_JWT_SECRET=replace-with-a-local-secret-at-least-32-characters
TEMP_AUTH_USER_TYPE=customer # customer | operator
