# Local PostgreSQL connection settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bottlemap
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=bottlemap
# Optional: libpq sslmode, e.g. require for RDS (default: prefer)
# POSTGRES_SSLMODE=require
# Test database used by pytest; its schema is dropped on every run, so it must end with _test
POSTGRES_TEST_DATABASE=bottlemap_test

# Menu photo storage and extraction (local development defaults)
IMAGE_STORAGE=local
# IMAGE_STORAGE_DIR=/absolute/path/for/images   # default: backend/var/images
# For S3 (deployment): IMAGE_STORAGE=s3 and
# S3_BUCKET=your-bucket
# AWS_REGION=ap-northeast-2
# S3_URL_TTL_SECONDS=900
# mock (default; fixed results, no key needed) | gemini (needs GEMINI_API_KEY and the EXTRACTION_* values below)
MENU_EXTRACTOR=mock

# Temporary authentication is disabled by default.
TEMP_AUTH_ENABLED=false
TEMP_AUTH_JWT_SECRET=replace-with-a-local-secret-at-least-32-characters
TEMP_AUTH_USER_TYPE=customer # customer | operator

# Menu extraction (app/extraction). Required only with MENU_EXTRACTOR=gemini; checked at server start.
GEMINI_API_KEY=
# P14 adopted condition A2: gemini-3.5-flash-lite with thinking medium
EXTRACTION_MODEL=gemini-3.5-flash-lite
EXTRACTION_THINKING_LEVEL=medium
# Optional; defaults are the P14 values (worst case several minutes per photo)
# EXTRACTION_MAX_ATTEMPTS=6
# EXTRACTION_REQUEST_TIMEOUT_S=300
# EXTRACTION_WALL_TIMEOUT_S=330
