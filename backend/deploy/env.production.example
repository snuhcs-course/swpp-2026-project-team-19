# backend/.env on the server. Copy, fill in, then: chmod 600 .env
# systemd reads this file too: plain KEY=VALUE lines only, no quotes, no comments after a value.

# RDS: the endpoint from the RDS console; the password is the master password set there.
POSTGRES_HOST=bottlemap-db.xxxxxxxxxxxx.ap-northeast-2.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=bottlemap
POSTGRES_PASSWORD=
POSTGRES_DATABASE=bottlemap
POSTGRES_SSLMODE=require

# Menu photos in S3; credentials come from the EC2 instance role.
IMAGE_STORAGE=s3
S3_BUCKET=bottlemap-menu-photos
AWS_REGION=ap-northeast-2
S3_URL_TTL_SECONDS=900

# Extraction: mock first. For real photos set gemini and a paid-tier GEMINI_API_KEY.
MENU_EXTRACTOR=mock
GEMINI_API_KEY=
EXTRACTION_MODEL=gemini-3.5-flash-lite
EXTRACTION_THINKING_LEVEL=medium
# I5-P19: MENU_EXTRACTOR=openrouter reads photos through OpenRouter and falls back to the Gemini API
# (DEPLOY.md, "Extraction through OpenRouter"). It needs every line below and the four above, and
# CLOVA_OCR_INVOKE_URL and CLOVA_OCR_SECRET. MENU_EXTRACTOR=gemini ignores these lines.
# OPENROUTER_API_KEY is the one key the course issued: evaluation runs use the same key and credits,
# and it has no spending limit of its own, so the server limits its own use (DEPLOY.md, "Spending").
OPENROUTER_API_KEY=
OPENROUTER_EXTRACTION_MODEL=google/gemini-3.8-flash
OPENROUTER_FALLBACK_MODELS=anthropic/claude-sonnet-5.5
EXTRACTION_DIRECT_MODEL=gemini-3.8-flash
# Photos the whole server sends to OpenRouter per day (KST); after that, photos start at the Gemini API.
OPENROUTER_DAILY_PHOTO_LIMIT=300
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=

# I5-A2: menu photos one user may upload per day (KST). About $0.03 a photo through OpenRouter.
MENU_PHOTO_DAILY_LIMIT=30

# LLM matching layer (I3) for menu lines the rules leave unconfirmed; uses GEMINI_API_KEY and stays off unless true.
# MATCHING_LLM_MODE: m3a (default) or tools (I3-E10; then also MATCHING_LLM_MAX_CALLS=90, see backend/README.md).
MATCHING_LLM_ENABLED=false
MATCHING_LLM_MODE=m3a
# Embedding candidate step for menu matching (I3-P40): off until the backend owner turns it on.
# With true it uses EMBEDDING_MODEL=tfidf and EMBEDDING_MIN_SIMILARITY=0.38 unless those are set.
EMBEDDING_ENABLED=false

# Customer search step 5 "similar" (API spec 3.10.1): off until the backend owner turns it on.
# With true it uses SEARCH_SIMILAR_MIN_SIMILARITY=0.38 unless that is set.
SEARCH_SIMILAR_ENABLED=false

# Owner applications: data.go.kr service key for the NTS business registration check (spec 3.11.2,
# 3.11.13). Empty: applications are accepted with the result unavailable, and the operator recheck answers 503.
NTS_SERVICE_KEY=

# Owner applications: keys for the stored business registration numbers (app/core/business_number_crypto.py).
# Required: the server does not start without them. Each is base64url of 32 random bytes; generate with
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep both in the team password manager too: without the encryption key the stored numbers are lost.
# ENCRYPTION_KEYS may list several keys, comma-separated, the newest first (key rotation, see DEPLOY.md).
BUSINESS_NUMBER_ENCRYPTION_KEYS=
BUSINESS_NUMBER_HMAC_KEY=

# Supabase Auth (Google login): the Project URL from the Supabase dashboard. Public; no Supabase key is needed.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# The operator dashboard (/admin) and the owner web (/owner/) sign in with Supabase in the browser: the project's publishable (or legacy
# anon) key. Public by design, sent to the browser; never the secret or service_role key.
SUPABASE_PUBLISHABLE_KEY=
# The pages' map and address search (/admin new_bar approvals, /owner/): the Kakao JavaScript key. Public by design; it
# works only on the domains registered in Kakao Developers (Platform > Web). Never the REST API or Admin key.
KAKAO_JAVASCRIPT_KEY=

# The owner web (/owner/): the build GitHub Actions uploads (deploy/owner-web-upload.sh). Until the first upload,
# /owner/ answers 503 and the API works as usual.
OWNER_WEB_DIR=/home/ubuntu/bottlemap-owner-web/current

# Temporary login (spec 3.1.3) is for local development only and stays off on the server (off since 2026-11-02).
TEMP_AUTH_ENABLED=false
