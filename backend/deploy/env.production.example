# backend/.env on the server. Copy, fill in, then: chmod 600 .env
# systemd reads this file too: plain KEY=VALUE lines only, no quotes, no comments after a value.

# RDS: the endpoint from the RDS console; the password is the master password set there.
POSTGRES_HOST=bottlemap-db.xxxxxxxxxxxx.ap-northeast-2.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=bottlemap
POSTGRES_PASSWORD=
POSTGRES_DATABASE=bottlemap
POSTGRES_SSLMODE=require

# Menu photos in S3; credentials come from the EC2 instance role.
IMAGE_STORAGE=s3
S3_BUCKET=bottlemap-menu-photos
AWS_REGION=ap-northeast-2
S3_URL_TTL_SECONDS=900

# Extraction: mock first. For real photos set gemini and a paid-tier GEMINI_API_KEY.
MENU_EXTRACTOR=mock
GEMINI_API_KEY=
EXTRACTION_MODEL=gemini-3.5-flash-lite
EXTRACTION_THINKING_LEVEL=medium

# Temporary login for the demo period only: anyone who reaches the server gets an operator token.
# Generate the secret with: openssl rand -hex 32
TEMP_AUTH_ENABLED=true
TEMP_AUTH_USER_TYPE=operator
TEMP_AUTH_JWT_SECRET=
