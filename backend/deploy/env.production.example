# backend/.env on the server. Copy, fill in, then: chmod 600 .env
# systemd reads this file too: plain KEY=VALUE lines only, no quotes, no comments after a value.

# RDS: the endpoint from the RDS console; the password is the master password set there.
POSTGRES_HOST=bottlemap-db.xxxxxxxxxxxx.ap-northeast-2.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=bottlemap
POSTGRES_PASSWORD=
POSTGRES_DATABASE=bottlemap
POSTGRES_SSLMODE=require

# Menu photos in S3; credentials come from the EC2 instance role.
IMAGE_STORAGE=s3
S3_BUCKET=bottlemap-menu-photos
AWS_REGION=ap-northeast-2
S3_URL_TTL_SECONDS=900

# Extraction: mock first. For real photos set gemini and a paid-tier GEMINI_API_KEY.
MENU_EXTRACTOR=mock
GEMINI_API_KEY=
EXTRACTION_MODEL=gemini-3.5-flash-lite
EXTRACTION_THINKING_LEVEL=medium

# Owner applications: data.go.kr service key for the NTS business registration check (spec 3.11.2,
# 3.11.13). Empty: applications are accepted with the result unavailable, and the operator recheck answers 503.
NTS_SERVICE_KEY=

# Supabase Auth (Google login): the Project URL from the Supabase dashboard. Public; no Supabase key is needed.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# The operator dashboard (/admin) signs in with Supabase in the browser: the project's publishable (or legacy
# anon) key. Public by design, sent to the browser; never the secret or service_role key.
SUPABASE_PUBLISHABLE_KEY=
# The dashboard's map and address search for new_bar approvals: the Kakao JavaScript key. Public by design; it
# works only on the domains registered in Kakao Developers (Platform > Web). Never the REST API or Admin key.
KAKAO_JAVASCRIPT_KEY=

# Temporary login (spec 3.1.3) is for local development only and stays off on the server (off since 2026-11-02).
TEMP_AUTH_ENABLED=false
