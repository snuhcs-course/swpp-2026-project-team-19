# Secrets: never commit any .env (only .env.example)
.env
# Menu photos stay outside the repo (owner consent scope; repo is public)
/data/
__pycache__/
*.pyc
.pytest_cache/
# CLOVA OCR raw responses (kept outside the repo in <data_dir>/ocr_cache)
ocr_cache/
# Label review pages embed menu photo crops (owner consent scope; repo is public)
review/*.html
# AI CI outputs when run locally (see .github/workflows/ai-ci.yml)
/.venv-ai/
/.coverage
/ai-coverage.json
/ai-junit.xml

# Android release signing secrets and local configuration
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
signing.properties
# Generated Android distribution artifacts
*.aab
*.apk
/.kotlin/

